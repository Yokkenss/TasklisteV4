<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anmelden</title>
    <link rel="stylesheet" href="/css/styles.css?v=7">
</head>
<body>
    <main class="page page-form">
        <header class="page-header"><h1>Anmelden</h1></header>
        <form method="POST" action="/login" class="panel task-form">
            <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
            <div class="field">
                <label for="email">E-Mail-Adresse</label>
                <input type="email" id="email" name="email" value="<%= email %>" maxlength="191" autocomplete="username" required>
            </div>
            <div class="field">
                <label for="password">Passwort</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <div class="form-actions">
                <button class="button button-primary">Anmelden</button>
                <a href="/register" class="button button-secondary">Registrieren</a>
            </div>
        </form>
    </main>
</body>
</html>
